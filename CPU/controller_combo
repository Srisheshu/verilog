
module controller_combo ( 
    input clk, 
    input reset, 
    input en, 
    input [3:0] opcode, 
  input neg_flag,
    output reg loadA, 
    output reg loadB, 
    output reg loadC, 
    output reg loadIR, 
    output reg loadPC, 
    output reg mode, 
    output reg we_DM, 
    output reg selA, 
    output reg selB
);

  
    typedef enum logic [3:0] {
        OP_ADD  = 4'b0000, OP_MUL  = 4'b0001, OP_SUB  = 4'b0010, OP_DIV  = 4'b0011,
        OP_LDA  = 4'b0100, OP_LDB  = 4'b0101, OP_LDC  = 4'b0110, OP_JMP  = 4'b0111,
        OP_AND  = 4'b1000, OP_OR   = 4'b1001, OP_NAND = 4'b1010, OP_NOR  = 4'b1011,
        OP_NOTA = 4'b1100, OP_NOTB = 4'b1101, OP_XOR  = 4'b1110, OP_BLT  = 4'b1111
    } opcode_t;

    opcode_t current_op;
     assign current_op = opcode_t'(opcode);

   
  always @(*) begin
      //$display("%b %b %b",en,opcode,reset);
   
//         if (reset) begin
//             loadA  <= 0; loadB  <= 0; loadC  <= 0; 
//             loadIR <= 0; loadPC <= 0; we_DM  <= 0;
//             selA   <= 0; selB   <= 0; mode   <= 0;
//         end 
         if (en) begin
              
//           loadA  <= 0; loadB  <= 0; loadC  <= 0; 
//             loadIR <= 0; loadPC <= 0; we_DM  <= 0;
//             selA   <= 0; selB   <= 0; mode   <= 1'bz; 
          
            case (current_op)
                
                OP_ADD, OP_MUL, OP_SUB, OP_DIV: begin
                    mode  <= 1;
                    we_DM <= 1'b0; loadA  <= 0; loadB  <= 0; loadC  <= 0; 
            loadIR <= 0; loadPC <= 0; 
            selA   <= 0; selB   <= 0;  
                end

              
                OP_LDA:begin
                  loadA <= 1'b1;
             loadB  <= 0; loadC  <= 0; 
            loadIR <= 0; loadPC <= 0; we_DM  <= 0;
                  selA   <= 0; selB   <= 0; mode   <= 0; end
              
              
                OP_LDB:begin loadB <= 1'b1;
              loadA  <= 0;  loadC  <= 0; 
            loadIR <= 0; loadPC <= 0; we_DM  <= 0;
                  selA   <= 0; selB   <= 0; mode   <= 0; end
              
              
                OP_LDC:begin loadC <= 1'b1;
              loadA  <= 0; loadB  <= 0; 
            loadIR <= 0; loadPC <= 0; we_DM  <= 1;
                  selA   <= 0; selB   <= 0; mode   <= 0; end
  
               
                OP_JMP: begin
                    loadPC <= 1'b1; 
                    selA   <= 1'b1; 
                    selB   <= 1'b1;
                  loadA  <= 0; loadB  <= 0; loadC  <= 0; 
            loadIR <= 0;  we_DM  <= 0;
            mode   <= 0; 
                end

                
                OP_AND, OP_OR, OP_NAND, OP_NOR,
                OP_NOTA, OP_NOTB, OP_XOR: begin
                    mode  <= 1;
                    we_DM <= 0; 
                  loadA  <= 0; loadB  <= 0; loadC  <= 1;  
            loadIR <= 0; loadPC <= 0;
            selA   <= 0; selB   <= 0; 
                end
              
              OP_BLT: begin
                if (neg_flag) begin
                  loadPC <= 1'b1; 
                  mode  <= 1;
                    we_DM <= 0; 
                  loadA  <= 0; loadB  <= 0; loadC  <= 0; 
            loadIR <= 0; 
            selA   <= 0; selB   <= 0; 
                end
                     else begin
                        loadPC <= 1'b0;
                       mode  <= 0;
                    we_DM <= 0; 
                  loadA  <= 0; loadB  <= 0; loadC  <= 0; 
            loadIR <= 0; 
            selA   <= 0; selB   <= 0; 
                    end
            
                end

//                 default: loadIR <= 1'b1; 
            endcase
        end
//         else begin
           
//             loadA  <= 0; loadB  <= 0; loadC  <= 0; 
//             loadIR <= 0; loadPC <= 0; we_DM  <= 0;
//             selA   <= 0; selB   <= 0; mode   <= 1'bz;
//        end       
       
    

       $display("time[%0d] en%b opcode%b reset%b loadA%b loadB%b loadC%b loadIR%b loadPC%b we_DM%b selA%b selB%b", $time, en, current_op, reset,loadA,loadB,loadC,loadIR,loadPC,we_DM,selA,selB);
    end
endmodule

