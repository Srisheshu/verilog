module data_memory (
    input  [11:0] addr,     
    input  [15:0] data_in,   
    input         write_en,
    input         clk,       
    output [15:0] data_out  
);

   
    reg [15:0] ram [4095:0];

   
    always @(posedge clk) begin
        if (write_en) begin
            ram[addr] <= data_in;
        end
    end

    assign data_out = ram[addr];

endmodule

