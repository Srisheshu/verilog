module reg_16bit (
    input [15:0] data_in,
    input ld,           
    input clk,         
    input rst,          
    output reg [15:0] q 
);

    always @(posedge clk or posedge rst) begin
        if (rst)
            q <= 16'b0;
        else if (ld)
            q <= data_in;
    end

endmodule

