
module mux (
  input  [11:0] pc_address,     
  input  [11:0] immediate_addr,  
    input wire loadpc,                  
  output wire [11:0] curr_addr       
);

  assign curr_addr = (loadpc == 1'b0) ? pc_address : immediate_addr;

endmodule

