#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0xdd51870 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0xdd514c0 .scope module, "tb" "tb" 3 6;
 .timescale -9 -9;
v0xdd78ba0_0 .var "clk100", 0 0;
v0xdd78c90_0 .net "clk25", 0 0, v0xdd78410_0;  1 drivers
v0xdd78da0_0 .net "clk50", 0 0, v0xdd77d70_0;  1 drivers
v0xdd78e40_0 .var "reset", 0 0;
S_0xdd623d0 .scope module, "dut" "freq_divider" 3 12, 4 17 0, S_0xdd514c0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk_100mhz";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 1 "q0";
    .port_info 3 /OUTPUT 1 "q1";
L_0xdd78ee0 .functor NOT 1, v0xdd77d70_0, C4<0>, C4<0>, C4<0>;
L_0xdd79030 .functor NOT 1, v0xdd78410_0, C4<0>, C4<0>, C4<0>;
v0xdd78640_0 .net "clk_100mhz", 0 0, v0xdd78ba0_0;  1 drivers
v0xdd78700_0 .net "d0", 0 0, L_0xdd78ee0;  1 drivers
v0xdd787d0_0 .net "d1", 0 0, L_0xdd79030;  1 drivers
v0xdd788d0_0 .net "q0", 0 0, v0xdd77d70_0;  alias, 1 drivers
v0xdd789c0_0 .net "q1", 0 0, v0xdd78410_0;  alias, 1 drivers
v0xdd78ab0_0 .net "reset", 0 0, v0xdd78e40_0;  1 drivers
S_0xdd62620 .scope module, "dff0" "dff" 4 28, 4 2 0, S_0xdd623d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "reset";
    .port_info 3 /OUTPUT 1 "q";
v0xdd64870_0 .net "clk", 0 0, v0xdd78ba0_0;  alias, 1 drivers
v0xdd77cb0_0 .net "d", 0 0, L_0xdd78ee0;  alias, 1 drivers
v0xdd77d70_0 .var "q", 0 0;
v0xdd77e40_0 .net "reset", 0 0, v0xdd78e40_0;  alias, 1 drivers
E_0xdd2b370 .event posedge, v0xdd77e40_0, v0xdd64870_0;
S_0xdd77fb0 .scope module, "dff1" "dff" 4 35, 4 2 0, S_0xdd623d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "reset";
    .port_info 3 /OUTPUT 1 "q";
v0xdd78280_0 .net "clk", 0 0, v0xdd77d70_0;  alias, 1 drivers
v0xdd78370_0 .net "d", 0 0, L_0xdd79030;  alias, 1 drivers
v0xdd78410_0 .var "q", 0 0;
v0xdd784e0_0 .net "reset", 0 0, v0xdd78e40_0;  alias, 1 drivers
E_0xdd78220 .event posedge, v0xdd77e40_0, v0xdd77d70_0;
    .scope S_0xdd62620;
T_0 ;
    %wait E_0xdd2b370;
    %load/vec4 v0xdd77e40_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0xdd77d70_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xdd77cb0_0;
    %assign/vec4 v0xdd77d70_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0xdd77fb0;
T_1 ;
    %wait E_0xdd78220;
    %load/vec4 v0xdd784e0_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_1.0, 4;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0xdd78410_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0xdd78370_0;
    %assign/vec4 v0xdd78410_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0xdd514c0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xdd78ba0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xdd78e40_0, 0, 1;
    %end;
    .thread T_2, $init;
    .scope S_0xdd514c0;
T_3 ;
    %delay 5, 0;
    %load/vec4 v0xdd78ba0_0;
    %inv;
    %store/vec4 v0xdd78ba0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0xdd514c0;
T_4 ;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xdd78e40_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xdd78e40_0, 0, 1;
    %delay 500, 0;
    %vpi_call/w 3 32 "$finish" {0 0 0};
    %end;
    .thread T_4;
    .scope S_0xdd514c0;
T_5 ;
    %vpi_call/w 3 35 "$dumpfile", "freq_divider.vcd" {0 0 0};
    %vpi_call/w 3 38 "$dumpvars", 32'sb00000000000000000000000000000001, S_0xdd514c0 {0 0 0};
    %end;
    .thread T_5;
