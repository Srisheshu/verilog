#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x283022d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x28302460 .scope module, "tb" "tb" 3 3;
 .timescale 0 0;
v0x28312f80_0 .net "a", 3 0, v0x28312d50_0;  1 drivers
v0x28313070_0 .var "clk", 0 0;
v0x28313140_0 .var "reset", 0 0;
S_0x282dd580 .scope module, "COUNTER1" "counter" 3 7, 4 2 0, S_0x28302460;
 .timescale 0 0;
    .port_info 0 /OUTPUT 4 "q";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "reset";
v0x282dd7f0_0 .net "clk", 0 0, v0x28313070_0;  1 drivers
v0x28312d50_0 .var "q", 3 0;
v0x28312e30_0 .net "reset", 0 0, v0x28313140_0;  1 drivers
E_0x282dd7b0 .event posedge, v0x282dd7f0_0;
    .scope S_0x282dd580;
T_0 ;
    %wait E_0x282dd7b0;
    %load/vec4 v0x28312e30_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x28312d50_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x28312d50_0;
    %addi 3, 0, 4;
    %assign/vec4 v0x28312d50_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x28302460;
T_1 ;
    %vpi_call/w 3 12 "$dumpfile", "tff_wave.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000001, S_0x28302460 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x28313070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x28313140_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x28313140_0, 0, 1;
    %delay 300, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x28302460;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x28313070_0;
    %inv;
    %store/vec4 v0x28313070_0, 0, 1;
    %jmp T_2;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
